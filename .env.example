# -------------------------------------------------------------------
# NovaIAx — environment variable template
# Copy this file to `.env` and fill in real values.
# NEVER commit a populated `.env` to version control.
# -------------------------------------------------------------------

# Environment: "development" (default) or "production".
# When "production", SECRET_KEY and MASTER_API_KEY must be strong and at least
# one AI provider API key must be present (GROQ_API_KEY, OPENAI_API_KEY,
# OPENROUTER_API_KEY or AI_PROVIDERS_JSON) or the application refuses to boot.
ENVIRONMENT=development

# ── Application / server ─────────────────────────────────────────
APP_NAME=novaiax-gateway
HOST=0.0.0.0
PORT=8000

# ── API key authentication header (default: X-API-Key) ───────────
API_KEY_HEADER=X-API-Key

# ── JWT / Authentication ─────────────────────────────────────────
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Default ADMIN account auto-created on first startup (when no admin exists).
# Email defaults to "admin@admin.com" if unset.  If the password is left
# unset, a strong random one is generated and logged once to the server
# console/logs on the first run so it can be retrieved.
ADMIN_DEFAULT_EMAIL=admin@admin.com
ADMIN_DEFAULT_PASSWORD=

# ── Admin console (/admin) ────────────────────────────────────────
# The operator panel is separate from the mobile API auth and is only
# reachable by users whose live DB role is ADMIN.  In production no admin
# is auto-created: provision one directly in the DB with
# `python scripts/make_admin_sql.py`.
# When false every /admin route returns 404.
ADMIN_PANEL_ENABLED=true
# Panel session cookie name (httpOnly, SameSite=Strict, path=/admin).
ADMIN_PANEL_COOKIE_NAME=novaiax_admin_panel
# Force TOTP for every admin; admins without a secret must enroll first.
ADMIN_REQUIRE_TOTP=false
ADMIN_TOTP_ISSUER=NovaIAx Admin
# Comma-separated IP allowlist for /admin (empty = allow any).
ADMIN_ALLOWED_IPS=
# Idle / absolute session timeouts.
ADMIN_SESSION_IDLE_MINUTES=60
ADMIN_SESSION_ABSOLUTE_HOURS=8

# ── Agent console (admin) ─────────────────────────────────────────
# Hard cap for any admin-authored prompt fragment (characters).
AGENT_PROMPT_MAX_CHARS=5000
# "Testar agente" sandbox: per-admin attempts per window, and the window
# length in seconds (set the limit to 0 to disable the sandbox throttle).
AGENT_PREVIEW_RATE_LIMIT=10
AGENT_PREVIEW_RATE_WINDOW_SECONDS=60

# ── Promo codes (public redemption) ───────────────────────────────
# Fixed-window throttle for POST /api/v1/me/promo-codes/redeem: attempts per
# user and per client IP, within the window below (seconds).
PROMO_REDEEM_USER_LIMIT=10
PROMO_REDEEM_IP_LIMIT=30
PROMO_REDEEM_WINDOW_SECONDS=60

# ── Configurações (remote config / plan overrides / AI ops) ───────
# Public app-config payload cache TTL (seconds); busted on every panel edit.
APP_CONFIG_CACHE_TTL_SECONDS=60
# How long a worker reuses the in-memory plan-ceiling override snapshot.
PLAN_LIMIT_OVERRIDE_TTL_SECONDS=30
# Retention of the per-plan/per-day AI usage aggregates used by the panel.
AI_USAGE_RETENTION_DAYS=35
# Rolling per-provider latency/error window size for the "Operações de IA" page.
AI_METRICS_WINDOW=200

# Master API key: any request carrying this key is fully trusted and
# bypasses per-key validation.  MUST NOT be a placeholder in production.
MASTER_API_KEY=

# ── Database ──────────────────────────────────────────────────────
# `postgres://` and `postgresql://` are normalised to the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://novaiax:novaiax@postgres:5432/novaiax

# Optional override used ONLY by Alembic (`alembic upgrade head`).  When set,
# migrations connect here instead of DATABASE_URL.  With Supabase the app may
# use the transaction pooler (pooled DATABASE_URL, port 6543, statement_cache_
# size=0) while migrations need the Supavisor SESSION-mode URL:
#   postgresql://<user>:<pass>@<project>-<region>.pooler.supabase.com:5432/postgres
# Never point this at the transaction pooler (port 6543) or at the IPv6-only
# direct host (`db.<ref>.supabase.co`) from an IPv4-only build environment.
MIGRATION_DATABASE_URL=

# Connection pool (PostgreSQL / MySQL / MariaDB only — ignored on SQLite).
# `pool_pre_ping` validates a pooled connection with a cheap SELECT 1 before
# handing it out, replacing it transparently when the server has already timed
# it out; without it a managed-Postgres idle timeout shows up as an
# intermittent 500.  `pool_recycle` retires connections proactively, before
# the provider drops them.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_PRE_PING=true

# ── Redis / Caching ───────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CACHE_TTL_DEFAULT=60
CACHE_TTL_AI=300

# ── Rate Limiting (requests per minute) ───────────────────────────
# Independent sliding windows: ordinary endpoints get RATE_LIMIT_DEFAULT,
# endpoints that call the AI provider get the stricter RATE_LIMIT_AI per IP.
# Once a request is authenticated with a JWT, AI paths are instead bucketed
# per user id with the stricter RATE_LIMIT_AI_USER, so one user cannot
# exhaust the shared IP allowance.  The buckets never consume each other.
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_AI=10
RATE_LIMIT_AI_USER=8

# First registrant bootstrap: when the database has no admin yet, the first
# registered account is promoted to ADMIN.  This is forced OFF in production
# (ENVIRONMENT=production) so a public sign-up can never self-promote.
FIRST_USER_ADMIN=true

# Trust proxy-set client-IP headers (X-Forwarded-For) when resolving the
# real client IP.  Set to "true" ONLY behind a trusted reverse proxy (e.g.
# the Render edge proxy).  Keep "false" for local dev so headers cannot be
# spoofed by a direct client.
TRUST_PROXY_HEADERS=false

# ── Payload Limit ─────────────────────────────────────────────────
# Maximum request body size in bytes (default 1 MiB).
MAX_PAYLOAD_BYTES=1048576

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated origins, or a JSON array.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Reverse-proxy downstream services ─────────────────────────────
# JSON list of {"name", "base_url", "timeout_seconds"} objects.
DOWNSTREAM_SERVICES_JSON=[{"name":"ai","base_url":"http://mock-ai-service:8001","timeout_seconds":5}]

# ── Groq Cloud AI ─────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_MODEL=openai/gpt-oss-120b

# ── Groq: time budget ─────────────────────────────────────────────
# One AI request must answer (successfully or with a mappable error) inside
# GROQ_REQUEST_BUDGET_SECONDS — the ceiling the mobile app waits for.  The
# budget is split in two: the in-process queue (rate pacer + concurrency
# semaphore share this single allowance) and the network call.  Values that do
# not fit are clamped, and anything above 60 is ignored.
#
#   GROQ_REQUEST_BUDGET_SECONDS=60, GROQ_QUEUE_WAIT_SECONDS=25
#     -> queue up to 25s, then up to ~25s on the wire, 5s of margin.
GROQ_REQUEST_BUDGET_SECONDS=60
GROQ_QUEUE_WAIT_SECONDS=25

# ── Groq: in-process pacer ────────────────────────────────────────
# Aggregate ceiling for this process, kept under the provider's own
# organization-wide quota so the API key is never the bottleneck.
GROQ_RATE_LIMIT_RPM=20
GROQ_TOKEN_BUDGET_PER_MINUTE=6000
GROQ_MAX_CONCURRENCY=2

# ── Groq: retries ─────────────────────────────────────────────────
# Keep at 1 on the free tier: every attempt counts against the org quota, so
# retrying inside an exhausted per-minute window only makes it worse.
GROQ_MAX_ATTEMPTS=1

# ── Optional extra providers ──────────────────────────────────────
# Any provider with a key here joins the AI routing pool together with Groq.
# Each provider is a separate priority slot: on a provider failure the router
# falls back to the next one, so no request is lost while one key is down or
# out of quota.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_MODEL=openai/gpt-4o-mini

# ── AI provider pool (advanced) ───────────────────────────────────
# Optional full replacement for the env-var providers above: a JSON list of
# {"name", "base_url", "api_key", "default_model", "models", "priority",
#  "enabled", "max_attempts", "max_output_tokens", "rpm", "tpm",
#  "max_concurrency", "breaker_failure_threshold", "breaker_cooldown_seconds"}.
# Providers without an api_key are dropped; entries are sorted by priority
# (lower = tried first) and only enabled ones are used.  When set, this list
# REPLACES the GROQ_/OPENAI_/OPENROUTER_ variables above.
# AI_PROVIDERS_JSON=[{"name":"openai","base_url":"https://api.openai.com/v1","api_key":"sk-...","default_model":"gpt-4o-mini","priority":10},{"name":"groq","base_url":"https://api.groq.com/openai/v1","api_key":"gsk_...","default_model":"openai/gpt-oss-120b","priority":20}]

# ── AI per-user daily quota (Redis) ───────────────────────────────
# Best-effort per-user budget reset at UTC midnight.  Counters are stored in
# Redis and charged ONLY after a successful answer; when the budget is spent
# further requests get a 429 with a Retry-After pointing at the reset.
AI_DEFAULT_DAILY_MESSAGES=200
AI_DEFAULT_DAILY_TOKENS=50000
AI_DEFAULT_MAX_OUTPUT_TOKENS=1024

# ── AI circuit breaker ────────────────────────────────────────────
# Per provider: N consecutive failures open the breaker (provider skipped for
# the cooldown window, other providers serve the request) until one success
# resets it.
AI_BREAKER_FAILURE_THRESHOLD=3
AI_BREAKER_COOLDOWN_SECONDS=30.0

# ── Seed script (scripts/seed_dev.py) ─────────────────────────────
# Password for the seeded test@novaiax.dev account.  Left empty, the script
# generates a strong one and prints it once.
SEED_PASSWORD=

# ── Privacy, consent and age gate ─────────────────────────────────
# See PRIVACY.md for the full feature documentation.
# Minimum age required to create an account (validated on birth_date).
MINIMUM_ACCOUNT_AGE_YEARS=18
# Version of each consent document a user accepts, per type.  New
# registrations auto-record "terms" and "privacy" with these versions; the
# others are opt-in through PUT /api/v1/me/consents.
CONSENT_VERSIONS_JSON={"terms": "1", "privacy": "1", "microphone": "1", "contacts": "1", "location": "1", "learning": "1"}

# ── Data retention ────────────────────────────────────────────────
# Rolling TTL applied to each user's conversation history (seconds; <= 0
# disables it).  AI_LOGS_RETENTION_DAYS is the retention window surfaced on
# the public /privacy page.
CONVERSATION_HISTORY_TTL_SECONDS=2592000
AI_LOGS_RETENTION_DAYS=90

# ── Failed-login lockout ──────────────────────────────────────────
# After this many wrong passwords within the window, further logins for the
# address get a 429 until the window expires (a success resets the counter).
LOGIN_FAILED_ATTEMPTS_THRESHOLD=5
LOGIN_FAILED_ATTEMPTS_WINDOW_SECONDS=900

# ── Data export rate limit ────────────────────────────────────────
# Per-user ceiling for GET /api/v1/me/export within the window.
DATA_EXPORT_MAX_PER_HOUR=10
DATA_EXPORT_WINDOW_SECONDS=3600

# ── Google Play billing ───────────────────────────────────────────
# Android application id (also used in the Play subscription-management deep
# link).  GOOGLE_PLAY_SERVICE_ACCOUNT_JSON is the service-account key as a
# single-line JSON string (grants `androidpublisher` access to verify
# purchases).  GOOGLE_PLAY_PRODUCTS_JSON maps plan names to Play product ids.
# GOOGLE_PLAY_RTDN_TOKEN guards POST /api/v1/billing/google/rtdn (the Pub/Sub
# push endpoint, called by Google, not a user); the optional
# GOOGLE_PLAY_RTDN_AUDIENCE additionally verifies the OIDC token audience.
# Required in production (ENVIRONMENT=production); must be a valid Android
# application id such as br.com.novaiax.agente.
GOOGLE_PLAY_PACKAGE_NAME=br.com.novaiax.agente
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PRODUCTS_JSON={"starter": "novaiax_starter", "pro": "novaiax_pro", "premium": "novaiax_premium"}
GOOGLE_PLAY_RTDN_TOKEN=
GOOGLE_PLAY_RTDN_AUDIENCE=
